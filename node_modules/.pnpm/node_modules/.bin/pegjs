#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/francesco/Source/archiverse/frontend/node_modules/.pnpm/pegjs@0.10.0/node_modules/pegjs/bin/node_modules:/Users/francesco/Source/archiverse/frontend/node_modules/.pnpm/pegjs@0.10.0/node_modules/pegjs/node_modules:/Users/francesco/Source/archiverse/frontend/node_modules/.pnpm/pegjs@0.10.0/node_modules:/Users/francesco/Source/archiverse/frontend/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/francesco/Source/archiverse/frontend/node_modules/.pnpm/pegjs@0.10.0/node_modules/pegjs/bin/node_modules:/Users/francesco/Source/archiverse/frontend/node_modules/.pnpm/pegjs@0.10.0/node_modules/pegjs/node_modules:/Users/francesco/Source/archiverse/frontend/node_modules/.pnpm/pegjs@0.10.0/node_modules:/Users/francesco/Source/archiverse/frontend/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../pegjs/bin/pegjs" "$@"
else
  exec node  "$basedir/../pegjs/bin/pegjs" "$@"
fi
