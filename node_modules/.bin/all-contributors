#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/francesco/Source/archiverse/frontend/node_modules/.pnpm/all-contributors-cli@6.26.1/node_modules/all-contributors-cli/dist/node_modules:/Users/francesco/Source/archiverse/frontend/node_modules/.pnpm/all-contributors-cli@6.26.1/node_modules/all-contributors-cli/node_modules:/Users/francesco/Source/archiverse/frontend/node_modules/.pnpm/all-contributors-cli@6.26.1/node_modules:/Users/francesco/Source/archiverse/frontend/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/francesco/Source/archiverse/frontend/node_modules/.pnpm/all-contributors-cli@6.26.1/node_modules/all-contributors-cli/dist/node_modules:/Users/francesco/Source/archiverse/frontend/node_modules/.pnpm/all-contributors-cli@6.26.1/node_modules/all-contributors-cli/node_modules:/Users/francesco/Source/archiverse/frontend/node_modules/.pnpm/all-contributors-cli@6.26.1/node_modules:/Users/francesco/Source/archiverse/frontend/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../all-contributors-cli/dist/cli.js" "$@"
else
  exec node  "$basedir/../all-contributors-cli/dist/cli.js" "$@"
fi
